GITHUB_TOKEN=your_github_personal_access_token_here
KAGGLE_TOKEN=your_kaggle_api_token_here
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id

# Authenticated Web Search for Architectural Repositories
# Supported providers: tavily (default), serper, or google
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your_web_search_api_key_here
# Optional for Google Custom Search:
# GOOGLE_SEARCH_CX=your_google_custom_search_cx_here
