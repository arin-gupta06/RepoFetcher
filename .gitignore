# Dependencies
/node_modules/

# Production / Build Output
/dist/
*.tsbuildinfo

# Environment & Sensitive Credentials
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key
*.cert
secrets/

# Large Datasets & Harvested Stores (Prevent Git Bloat)
/data/
/archive/
*.jsonl
checkpoints.json

# Legacy Data Files
datasets.json
readmes.json
repositories.json

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Operating System & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large Model Weights (> 100MB exceeds GitHub push limit)
*.safetensors
*.bin
models/distilbert/*.safetensors
models/distilbert_base/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
api/__pycache__/